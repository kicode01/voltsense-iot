{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15,
      "includeFiles": "node_modules/firebase-admin/**"
    }
  },
  "rewrites": [
    { "source": "/demo", "destination": "/cad/voltsense_system_demo_3d.html" },
    { "source": "/3d-demo", "destination": "/cad/voltsense_system_demo_3d.html" },
    { "source": "/cad/(.*)", "destination": "/cad/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|cad/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
