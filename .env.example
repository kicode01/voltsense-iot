VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Web Push certificate key pair -> Firebase Console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key

# ---------------------------------------------------------------------------
# Server-only. These are read by api/alert.js, api/pair.js and api/claim.js on
# Vercel and must NEVER be prefixed with VITE_ — anything VITE_-prefixed is
# inlined into the browser bundle, which would publish your service account to
# the world.
#
# Set these in the Vercel dashboard (Project > Settings > Environment Variables),
# not in this file. Locally, use `vercel env pull` or `vercel dev`.
# ---------------------------------------------------------------------------

# Shared secret the ESP32 sends with every alert. Stored on the device in NVS
# as `alert_secret` (see esp32/ProvisionToken/ProvisionToken.ino). Generate one
# with:  openssl rand -hex 32
VOLTSENSE_ALERT_SECRET=

# Factory pairing key burned into every unit at flash time (`VOLTSENSE_PAIRING_KEY`
# in the firmware). It is the ONLY credential a factory-fresh device holds, and it
# buys exactly one thing: the right to call POST /api/pair and be issued a unique
# device_email / device_password / alert_secret. It must be identical across units
# and must never be readable over the air. Generate one with:
#   openssl rand -hex 32
VOLTSENSE_PAIRING_KEY=

# The Auth email domain used to synthesise per-device accounts during pairing
# (`device-<mac>@<domain>`). Defaults to the value derived from the Firebase
# project. Override only if you use a custom auth domain.
VOLTSENSE_AUTH_DOMAIN=

# The Firebase service-account JSON for the volt-sense project, flattened onto
# one line. Firebase Console > Project settings > Service accounts > Generate
# new private key, then:  jq -c . serviceAccountKey.json
#
# The Admin SDK bypasses database rules entirely, which is what lets /api/pair
# write `device_uids/<MAC>` — a node with no client `.write` rule in any variant.
FIREBASE_SERVICE_ACCOUNT=

# Realtime Database URL (same host as the app's databaseURL).
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app

