{
  "name": "voltsense",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "mint-token": "node scripts/mint-device-token.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "test-alert": "node scripts/test-alert.mjs",
    "rules:status": "node scripts/set-rules.mjs status",
    "rules:scoped": "node scripts/set-rules.mjs scoped",
    "rules:deviceuid": "node scripts/set-rules.mjs deviceuid",
    "rules:strict": "node scripts/set-rules.mjs strict",
    "deploy:rules": "firebase deploy --only database",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node verify-fixes.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:integration",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:vercel": "vercel --prod",
    "flash:firmware": "node scripts/flash-firmware.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "driver.js": "^1.8.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^11.11.0",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
